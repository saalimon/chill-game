{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "daily": {
      ".read": true,
      ".write": false
    },
    "dailyResults": {
      "$date": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['timeMs', 'completedAt'])"
        }
      }
    }
  }
}
