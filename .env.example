# Firebase web config. These values are public by design — the app is secured by
# Realtime Database rules and the Authorized Domains list, not by hiding these.
# In CI they are injected from GitHub Actions secrets at build time.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
